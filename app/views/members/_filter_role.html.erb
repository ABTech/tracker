<%= form_tag({:action=>"index"}, :method => "get", :id=>"filter_role")  do %>
  <table>
    <% Member.role.values.each do |role| %>
      <tr>
        <td><%= label_tag(role, role.text) %>:</td>
        <td><%= check_box_tag(role, 1, params[:filter] != "1" || params[role] == "1") %></td>
      </tr>
    <% end %>
  </table>
  <%= hidden_field_tag 'filter', 1 %>
  <%= hidden_field_tag 'active_only', params[:active_only] if params[:active_only].present? %>
  <%= hidden_field_tag 'order', params[:order] if params[:order].present? %>
  <%= hidden_field_tag 'desc', params[:desc] if params[:desc].present? %>
  <%= submit_tag "Apply Filter", :name => nil %>
<% end %>
